{
  "name": "enclave-education",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @enclave/web -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "dotnet run --project services/EnclaveEducation.Api --launch-profile http",
    "dev:desktop": "npm run tauri -w @enclave/desktop -- dev",
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build -w @enclave/web && npm run build -w @enclave/desktop && dotnet build EnclaveEducation.slnx",
    "build:desktop": "npm run tauri -w @enclave/desktop -- build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
